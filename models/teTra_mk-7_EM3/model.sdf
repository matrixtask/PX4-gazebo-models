    <!-- Pusher drive fixed mass: 2x EMRAX 268 LV +100% LC motors (44.6 kg) + 2x HBCi400800 water-cooled inverters (9.6 kg). -->
    <link name='pusher_drive'>
      <pose>-1.80 0 0.25 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>54.2</mass>
        <inertia>
