        <geometry><cylinder><length>0.1800</length><radius>0.1524</radius></cylinder></geometry>
        <surface>
          <contact><ode><kp>30000</kp><kd>6400</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
