<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.10'>
  <model name='teTra_mk-7_EM3'>
    <pose>0 0 0.80 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name='base_link'>
      <enable_wind>true</enable_wind>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- 2026-10-29 EM2 重量重心実測値（EM２重量重心表 実測値 / @JP 817・818(5°傾斜)）に合わせて修正。
             全機 1312.2 kg（全リンク合計）。全機重心 = FS 5966.9 mm（推力中心 FS 6165 の 198 mm 前方）、
             BL +9.6 mm（左）、ジャッキポイント支持線から 1.021 m 上（5°傾斜計測から算出。z はジャッキ点を主輪接地面と同じ高さと仮定）。
             base_link はモーター/ESC/ロータ/プッシャー（計 266.4 kg）を除いた分。
             リンク原点 x=0 は推力中心(FS 6165)、z は旧モデル基準のまま（主輪接地 z=-0.80）。
             慣性: 重量重心表 817 の搭載品（点質量）＋主翼・胴体・ブームの細長棒近似から全機 Ixx 7518 / Iyy 5691 / Izz 12851 kg·m²（概算）。base_link は他リンク分を差し引いた値。Ixz は旧値のまま。
             旧値: mass 1293.575, pose (0,0,-0.20)。CA_ROTOR*_PX/PZ は旧重心(0,0,-0.20)基準なので要再計算。 -->
        <pose>0.3456 0.0120 0.0771 0 0 0</pose>
        <!-- 2026-11-01 EM3: 全機 1560 kg（指示値）。差分 +247.8 kg を base_link 重心位置に加算、base_link 慣性は質量比 1.2370 倍（概算）。重心位置は EM2 実測のまま（EM3 実測待ち）。 -->
        <mass>1293.567</mass>
        <inertia>
          <ixx>7392.5</ixx>
          <ixy>0.000000</ixy>
          <ixz>-163.6987</ixz>
          <iyy>4532.5</iyy>
          <iyz>-0.000000</iyz>
          <izz>11797.0</izz>
        </inertia>
      </inertial>
      <!-- Landing gear (2026-10-29 修正): 車輪位置は設計値 NLG FS 4300 (x=+1.865), MLG FS 6540 (x=-0.375), MLG BL ±911.5。
           重量重心表 @JP シートの FS 4121/6110 はジャッキポイント（車輪ではない）。
           脚はばね（線形）を仮定: 主輪 kp=6.0e4 N/m・前輪 kp=3.0e4 N/m（中井：前回仮値の半分程度）。静的沈み込み 主輪約80 mm・前輪約110 mm。
           駐機姿勢で前輪が主輪より 167 mm 低い（実機値）→ 無負荷の前輪は 137 mm 短くモデル化。駐機姿勢 約 -4.3°。 -->
      <collision name='main_landing_gear_left_strut_collision'>
        <pose>-0.375 0.9115 -0.380 0 0 0</pose>
        <geometry><box><size>0.080 0.080 0.460</size></box></geometry>
      </collision>
      <!-- Airframe visual generated from the X-Plane aircraft (Mk7_EM2_Panda.acf + fuselage.obj) by
           mk7_mission/tools/xplane_to_gazebo.py; aligned on the 12 lift-rotor positions (max error 0.02 m).
           EM3 shares the EM2 outer shape. Visual only: collision, mass and aerodynamics are unchanged. -->
      <visual name='airframe_xplane_visual'>
        <geometry><mesh><uri>model://teTra_mk-7_EM3/meshes/airframe_xplane.stl</uri></mesh></geometry>
        <material><ambient>0.80 0.82 0.85 1</ambient><diffuse>0.80 0.82 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name='main_landing_gear_left_strut_visual'>
        <pose>-0.375 0.9115 -0.380 0 0 0</pose>
        <geometry><box><size>0.080 0.080 0.460</size></box></geometry>
        <material><ambient>0.42 0.43 0.43 1</ambient><diffuse>0.42 0.43 0.43 1</diffuse></material>
      </visual>
      <collision name='main_landing_gear_right_strut_collision'>
        <pose>-0.375 -0.9115 -0.380 0 0 0</pose>
        <geometry><box><size>0.080 0.080 0.460</size></box></geometry>
      </collision>
      <visual name='main_landing_gear_right_strut_visual'>
        <pose>-0.375 -0.9115 -0.380 0 0 0</pose>
        <geometry><box><size>0.080 0.080 0.460</size></box></geometry>
        <material><ambient>0.42 0.43 0.43 1</ambient><diffuse>0.42 0.43 0.43 1</diffuse></material>
      </visual>
      <collision name='nose_landing_gear_strut_collision'>
        <pose>1.865 0 -0.263 0 0 0</pose>
