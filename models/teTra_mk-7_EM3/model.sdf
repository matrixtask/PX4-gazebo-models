      <cp>-0.435 -1.650 0.730</cp><area>3.00</area><air_density>1.2041</air_density><forward>1 0 0</forward><upward>0 0 1</upward><link_name>base_link</link_name><control_joint_name>servo_6</control_joint_name><control_joint_rad_to_cl>1.4</control_joint_rad_to_cl>
    </plugin>


    <!-- 2026-11-01 EM3: 定常フラップ 45°＋昇降舵トリム案は不採用（ロータ負荷低減 3% のみ）。旧設定は model.sdf.bak_20261101_flap45 -->
    <!-- [MOD-4] Flaperon/spoiler DRAG term (custom). ADDS drag only; existing CL coefficients unchanged.
         dCdS = cd_plate * flap_area * sin(|delta|) per flaperon (servo_5,servo_6), summed; applied at CoM
         (symmetric up-deflection = pure drag, no roll). User-authorised drag-term addition. -->
    <!-- Wake-vortex encounter (test only, inactive unless MK7_WAKE is set, see WakeVortex.hpp): strip lift on the
         wing (8.0 x 1.5 m at wing_fixed, CLa 4.74 from AdvancedLiftDrag, stall ~0.34 rad) and the horizontal tail
         (2.9 x 0.6 m at htail_fixed). -->
    <plugin filename="WakeVortex" name="WakeVortex">
      <link_name>base_link</link_name>
      <air_density>1.2041</air_density>
      <strips>16</strips>
      <surface>-0.135 0.930 8.0 1.5 4.74 1.2</surface>
      <surface>-4.896 0.960 2.9 0.6 3.5 1.0</surface>
    </plugin>
    <plugin filename="FlaperonDrag" name="FlaperonDrag">
      <link_name>base_link</link_name>
      <air_density>1.2041</air_density>
      <cd_plate>1.0</cd_plate>
      <flap_area>0.90</flap_area>
      <baseline_rad>0.61</baseline_rad>
      <!-- Airframe parasite drag not in the wing/fuselage terms: the route evaluation (optimizer_model_1410)
           uses CD0 0.0563 on 10.84 m^2 = 0.61 m^2 for the whole aircraft; wing CD0 0.0065 x 12 m^2 = 0.08 m^2 here. -->
      <base_cda>0.53</base_cda>
    </plugin>

    <!-- [MOD-5] Pusher advance-ratio model (custom PropellerAero). MulticopterMotorModel gives T = k w^2 at any
         airspeed: no thrust lapse and no drag from an idling/windmilling propeller. PropellerAero corrects it.
         J0 4.0: 2.6 kN at 72 m/s at full speed, the cruise thrust of the route evaluation (momentum theory,
         217.8 kW, eta 0.9). A beta-26 deg fixed-pitch blade at 2383 rpm would reach zero thrust near J 1.3-1.5
         (0.8-1.4 kN at 72 m/s): pusher sizing is an open risk (R12), not settled by this model.
         windmill_cd 0.12 on the 2.54 m^2 disk: ~0.95 kN at 72 m/s idle (estimate; R12, replace by test data). -->
    <plugin filename="PropellerAero" name="PropellerAero">
      <link_name>base_link</link_name>
      <joint_name>rotor_12_joint</joint_name>
      <axis>1 0 0</axis>
      <motor_constant>0.05557</motor_constant>
      <rotor_velocity_slowdown_sim>10</rotor_velocity_slowdown_sim>
      <diameter>1.8</diameter>
      <zero_thrust_advance_ratio>4.0</zero_thrust_advance_ratio>
      <windmill_cd>0.12</windmill_cd>
      <air_density>1.2041</air_density>
    </plugin>

