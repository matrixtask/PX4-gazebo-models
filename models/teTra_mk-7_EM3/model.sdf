        <geometry><cylinder><length>0.1696</length><radius>0.1905</radius></cylinder></geometry>
        <surface>
          <contact><ode><kp>60000</kp><kd>10600</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
